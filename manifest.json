{
  "manifest_version": 3,
  "name": "Media24 - Help Tools",
  "version": "1.0.0",
  "description": "Provides editor help tools for quick editing, cache purging, and page overlays",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "declarativeContent"
  ],
  "host_permissions": [
    "http://svet24.test/*",
    "https://svet24.si/*",
    "https://*.svet24.si/*",
    "https://*.necenzurirano.si/*",
    "https://*.reporter.si/*",
    "https://api.kme.si/*",
    "https://api3.m24.si/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://svet24.test/*",
        "https://svet24.si/*",
        "https://*.svet24.si/*",
        "https://*.necenzurirano.si/*",
        "https://*.reporter.si/*"
      ],
      "js": ["config.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
